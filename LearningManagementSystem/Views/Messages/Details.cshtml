@using AppData.Models
@model Message

@{
    ViewData["Title"] = "Преглед на съобщение";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card card-custom shadow-lg border-0">
                <div class="card-header bg-orange-light text-orange border-bottom border-warning py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-envelope-open me-2"></i>Съобщение</h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase">От:</label>
                        <p class="fs-5 fw-bold text-dark">@Model.Sender</p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase">Дата:</label>
                        <p class="text-secondary">@Model.SendDate.ToString("f")</p>
                    </div>

                    <hr class="text-orange opacity-25" />

                    <div class="mb-4">
                        <label class="text-muted small fw-bold text-uppercase mb-2">Съдържание:</label>
                        <div class="p-3 bg-light rounded-3 border">
                            @Model.Text
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-orange px-4">
                            <i class="bi bi-arrow-left me-2"></i>Назад
                        </a>
                        <a asp-action="Add" class="btn btn-orange ms-2 px-4">
                            <i class="bi bi-reply me-2"></i>Отговори
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>