@using AppData.Models
@model IEnumerable<Message>

@{
    ViewData["Title"] = "Съобщения";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold" style="color: #5d4037;"><i class="bi bi-chat-left-text me-2"></i>Съобщения</h2>

        <div class="d-flex gap-2">
            <form method="get" asp-action="Index" class="d-flex align-items-center">
                <select name="filter" onchange="this.form.submit()">
                    <option value="all" selected="@((currentFilter == "all") ? "selected" : null)">Всички</option>
                    <option value="unread" selected="@((currentFilter == "unread") ? "selected" : null)">Непрочетени</option>
                    <option value="read" selected="@((currentFilter == "read") ? "selected" : null)">Прочетени</option>
                </select>
            </form>

            <a asp-action="Add" class="btn btn-orange rounded-pill px-4">
                <i class="bi bi-pencil-square me-2"></i>Ново
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center border-0 shadow-sm bg-orange-light text-dark" role="alert">
            <i class="bi bi-inbox me-2"></i>Няма намерени съобщения в тази категория.
        </div>
    }
    else
    {
        <div class="list-group shadow-sm border-0 rounded-3">
            @foreach (var msg in Model)
            {
                // Ако е непрочетено -> по-дебел оранжев бордюр и удебелен шрифт
                var readClass = msg.IsRead ? "bg-white text-secondary" : "bg-orange-light fw-bold text-dark";
                var borderClass = msg.IsRead ? "border-secondary" : "border-warning";

                // Линка сочи към Details метода, който ще го маркира като прочетено
                <a asp-action="Details" asp-route-id="@msg.Id" class="list-group-item list-group-item-action border-0 mb-2 rounded-3 p-3 @readClass" style="border-left: 5px solid @(msg.IsRead ? "#ced4da" : "#e67e22") !important;">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1 @(msg.IsRead ? "fw-normal" : "fw-bold")">
                            <i class="bi @(msg.IsRead ? "bi-envelope-open" : "bi-envelope-fill text-orange") me-2"></i>
                            От: @msg.Sender
                        </h5>
                        <small class="text-muted">
                            <i class="bi bi-clock me-1"></i>@msg.SendDate.ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </div>
                    <p class="mb-1 mt-2 text-truncate" style="max-width: 80%;">
                        @msg.Text
                    </p>
                </a>
            }
        </div>
    }
</div>