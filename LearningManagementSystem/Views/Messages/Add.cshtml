@model Message

@{
    ViewData["Title"] = "New Message";
}

<h2 class="mb-3">Send Message</h2>

<form asp-action="Add" method="post" class="card p-4 shadow-sm">

    <div class="mb-3">
        <label asp-for="Receiver" class="form-label">Receiver Email</label>
        <input asp-for="Receiver" class="form-control" />
        <span asp-validation-for="Receiver" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Text" class="form-label">Message</label>
        <textarea asp-for="Text" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Text" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            Send
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
