<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LMS Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* Глобални променливи за темата */
        :root {
            --primary-orange: #e67e22;
            --light-orange: #fff3e0;
            --dark-brown: #5d4037;
            --text-dark: #2c3e50;
        }

        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Навигация Стил */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 3px solid var(--light-orange);
        }

        .navbar-brand {
            font-size: 1.5rem;
            color: var(--dark-brown) !important;
            letter-spacing: 0.5px;
        }

        .nav-link {
            color: #555 !important;
            font-weight: 500;
            transition: all 0.3s ease;
            position: relative;
            padding: 0.5rem 1rem !important;
        }

            /* Ефект при ховър на линковете */
            .nav-link:hover, .nav-link.active {
                color: var(--primary-orange) !important;
                background-color: var(--light-orange);
                border-radius: 20px;
            }

        /* Админ меню стил */
        .dropdown-item:active {
            background-color: var(--primary-orange);
        }

        /* Footer */
        footer {
            background-color: white;
            color: #6c757d;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom shadow-sm mb-4 sticky-top">

            <div class="container-fluid px-4">

                <a class="navbar-brand fw-bold d-flex align-items-center text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2" style="color: var(--primary-orange); font-size: 1.5rem;"></i>
                    <span>LMS</span><small class="text-muted ms-1 fw-normal">Portal</small>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-nowrap" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Начало
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap" asp-area="" asp-controller="StudyMaterials" asp-action="Index">
                                <i class="bi bi-book me-1"></i> Материали
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap" asp-area="" asp-controller="Tests" asp-action="Index">
                                <i class="bi bi-pencil-square me-1"></i> Тестове
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-nowrap" asp-area="" asp-controller="Messages" asp-action="Index">
                                <i class="bi bi-chat-dots me-1"></i> Съобщения
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown ms-lg-2">
                                <a class="nav-link dropdown-toggle text-danger fw-bold text-nowrap" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Админ
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Users" asp-action="Index">
                                            <i class="bi bi-people me-2"></i>Потребители
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register">
                                            <i class="bi bi-person-plus me-2"></i>Регистрирай нов
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center ms-auto">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    @* <footer class="border-top footer py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; 2025 - LMS Portal | Learning Management System</small>
            <div class="mt-1">
                <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted mx-2">Политика за поверителност</a>
            </div>
        </div>
    </footer> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>