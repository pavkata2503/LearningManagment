
<link rel="stylesheet" href="~/css/pagination.css" />
<nav aria-label="Page navigation">
    <ul class="pagination mb-0 shadow-sm rounded-pill overflow-hidden">

        @* Първа страница *@
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="1"
               asp-route-pageSize="@ViewBag.PageSize">
                <i class="bi bi-chevron-double-left"></i> Първа
            </a>
        </li>

        @* Предишна страница *@
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
               asp-route-pageSize="@ViewBag.PageSize">Предишна</a>
        </li>

        @* Информация за текущата страница *@
        <li class="page-item active">
            <span class="page-link custom-pg-info">
                Страница @ViewBag.CurrentPage от @ViewBag.TotalPages
            </span>
        </li>

        @* Следваща страница *@
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
               asp-route-pageSize="@ViewBag.PageSize">Следваща</a>
        </li>

        @* Последна страница *@
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@ViewBag.TotalPages"
               asp-route-pageSize="@ViewBag.PageSize">
                Последна <i class="bi bi-chevron-double-right"></i>
            </a>
        </li>

    </ul>
</nav>