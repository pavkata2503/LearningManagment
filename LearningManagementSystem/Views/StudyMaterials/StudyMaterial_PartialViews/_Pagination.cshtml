<nav aria-label="Page navigation">
    <ul class="pagination mb-0 shadow-sm rounded-pill overflow-hidden">

        @* Първа страница *@
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="1"
               asp-route-pageSize="@ViewBag.PageSize">
                <i class="bi bi-chevron-double-left"></i> Първа
            </a>
        </li>

        @* Предишна страница *@
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@(ViewBag.CurrentPage - 1)"
               asp-route-pageSize="@ViewBag.PageSize">Предишна</a>
        </li>

        @* Информация за текущата страница *@
        <li class="page-item active">
            <span class="page-link custom-pg-info">
                Страница @ViewBag.CurrentPage от @ViewBag.TotalPages
            </span>
        </li>

        @* Следваща страница *@
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@(ViewBag.CurrentPage + 1)"
               asp-route-pageSize="@ViewBag.PageSize">Следваща</a>
        </li>

        @* Последна страница *@
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link custom-pg-link"
               asp-action="Index"
               asp-route-pageNumber="@ViewBag.TotalPages"
               asp-route-pageSize="@ViewBag.PageSize">
                Последна <i class="bi bi-chevron-double-right"></i>
            </a>
        </li>

    </ul>
</nav>

<style>
    /* Бутоните (Предишна, Следваща и т.н.) */
    .custom-pg-link {
        color: var(--lms-brown) !important;
        background-color: #ffffff !important;
        border: 1px solid var(--lms-beige) !important;
        font-weight: 600;
        transition: all 0.2s ease;
        padding: 10px 20px;
    }

        .custom-pg-link:hover {
            background-color: var(--lms-orange) !important;
            color: white !important;
            border-color: var(--lms-orange) !important;
        }

    /* Активната част (Информацията за страницата) */
    .custom-pg-info {
        background-color: var(--lms-beige) !important;
        border-color: var(--lms-beige) !important;
        color: var(--lms-brown) !important;
        font-weight: 700;
        padding: 10px 20px;
    }

    /* Стил за деактивираните бутони */
    .page-item.disabled .custom-pg-link {
        background-color: #fcfcfc !important;
        color: #d1d1d1 !important;
        border-color: #f1f1f1 !important;
        cursor: not-allowed;
    }

    /* Премахване на синия фокус на Bootstrap */
    .page-link:focus {
        box-shadow: 0 0 0 0.25rem rgba(230, 126, 34, 0.25);
    }
</style>