@using AppData.Models.ViewModels
@model IEnumerable<StudyMaterialViewModel>
<style>
    .hover-orange:hover {
        color: #e67e22 !important;
        transition: color 0.2s;
    }
    /* Стилове за картите с материали */
    .material-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
        position: relative;
        border: 1px solid #eee;
    }

        .material-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border-color: var(--primary-orange);
        }

    .file-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-right: 15px;
        flex-shrink: 0;
    }

    /* Цветови теми за различните формати */
    .type-pdf {
        background-color: #ffebee;
        color: #d32f2f;
    }

    .type-image {
        background-color: #ede7f6;
        color: #673ab7;
    }

    .type-doc {
        background-color: #e3f2fd;
        color: #1976d2;
    }

    .type-default {
        background-color: #fff3e0;
        color: #e67e22;
    }

    .btn-download {
        background-color: #f8f9fa;
        color: #5d4037;
        border: 1px solid #e0e0e0;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-download:hover {
            background-color: var(--primary-orange);
            color: white;
            border-color: var(--primary-orange);
        }

    .delete-btn-corner {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #adb5bd;
        transition: color 0.2s;
        background: transparent;
        border: none;
    }

        .delete-btn-corner:hover {
            color: #dc3545;
        }
</style>
