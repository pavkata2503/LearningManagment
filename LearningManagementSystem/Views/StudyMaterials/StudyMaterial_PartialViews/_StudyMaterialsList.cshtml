@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded-3 shadow-sm border-0">
        <div class="mb-3">
            <i class="bi bi-folder2-open display-1 text-orange opacity-50" style="color: #e67e22;"></i>
        </div>
        <h4 class="text-dark fw-bold">Няма намерени материали</h4>
        <p class="text-muted">Опитайте да промените филтрите или добавете нов материал.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            // --- ЛОГИКА ЗА ВИД ФАЙЛ ---
            string typeClass = "type-default";
            string iconClass = "bi-file-earmark-text";
            string fileTypeLabel = "Файл";

            var fileType = item.TypeFile.ToString();

            if (fileType.Contains("Pdf"))
            {
                typeClass = "type-pdf";
                iconClass = "bi-file-earmark-pdf-fill";
                fileTypeLabel = "PDF Документ";
            }
            else if (fileType.Contains("Image"))
            {
                typeClass = "type-image";
                iconClass = "bi-file-earmark-image-fill";
                fileTypeLabel = "Изображение";
            }
            else if (fileType.Contains("Word") || fileType.Contains("Doc"))
            {
                typeClass = "type-doc";
                iconClass = "bi-file-earmark-word-fill";
                fileTypeLabel = "Word Документ";
            }
            // --------------------------

            <div class="col">
                <div class="card material-card h-100 shadow-sm">
                    
                    @if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
                    {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете: @item.Title?');">
                            <button type="submit" class="delete-btn-corner p-2" title="Изтрий материал">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    }

                    <div class="card-body p-4 d-flex flex-column">
                        
                        <div class="d-flex align-items-start mb-3">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                <div class="file-icon-wrapper @typeClass shadow-sm">
                                    <i class="bi @iconClass"></i>
                                </div>
                            </a>
                            <div class="mt-1">
                                <span class="badge bg-light text-secondary border mb-1">@item.Category</span>
                                <div class="small text-muted" style="font-size: 0.75rem;">@fileTypeLabel</div>
                            </div>
                        </div>

                        <h5 class="card-title fw-bold mb-2 text-truncate" title="@item.Title">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none hover-orange">
                                @item.Title
                            </a>
                        </h5>

                        <p class="card-text text-muted small flex-grow-1 mb-3">
                            @(item.Description != null && item.Description.Length > 80
                                ? item.Description.Substring(0, 80) + "..."
                                : item.Description ?? "Няма описание")
                        </p>

                        <div class="mt-auto pt-3 border-top border-light d-flex justify-content-between align-items-center">
                            <small class="text-muted fst-italic" style="font-size: 0.75rem;">
                                @item.CreatedOn.ToString("dd.MM.yyyy")
                            </small>

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border shadow-sm text-secondary" title="Преглед">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a href="@item.FileUrl" download="@item.FileName" class="btn btn-sm btn-download rounded-pill px-3 shadow-sm" title="Изтегли">
                                    <i class="bi bi-cloud-arrow-down-fill"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}