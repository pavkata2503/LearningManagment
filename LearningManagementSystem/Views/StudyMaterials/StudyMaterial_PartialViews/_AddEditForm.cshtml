@using AppData.Enums
@model AppData.Models.StudyMaterial

@{
    ViewData["Title"] = "Създаване на материал";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Създай нов учебен материал</h3>
                </div>

                <div class="card-body">
                    <form asp-action="Add" asp-controller="StudyMaterials" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Заглавие</label>
                            <input asp-for="Title" class="form-control" placeholder="Въведете заглавие на урока..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Subject" class="form-label">Предмет</label>
                                <input asp-for="Subject" class="form-control" placeholder="Напр. Математика" />
                                <span asp-validation-for="Subject" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Class" class="form-label">Клас</label>
                                <input asp-for="Class" type="number" min="1" max="12" class="form-control" placeholder="1-12" />
                                <span asp-validation-for="Class" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Category" class="form-label">Категория</label>
                                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-select">
                                    <option value="" selected disabled>-- Избери категория --</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TypeFile" class="form-label">Тип на файла</label>
                                <select asp-for="TypeFile" asp-items="Html.GetEnumSelectList<TypeFile>()" class="form-select">
                                    <option value="" selected disabled>-- Избери тип --</option>
                                </select>
                                <span asp-validation-for="TypeFile" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="URL" class="form-label">URL (Видео връзка и др.)</label>
                            <input asp-for="URL" class="form-control" placeholder="https://example.com" />
                            <span asp-validation-for="URL" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Описание</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Кратко описание на материала..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="card bg-light mb-4 border-dashed">
                            <div class="card-body text-center">
                                <label asp-for="FileUpload" class="form-label fw-bold">Прикачи файл</label>
                                <input asp-for="FileUpload" type="file" class="form-control" />
                                <small class="text-muted d-block mt-1">Поддържани формати според избрания тип.</small>
                                <span asp-validation-for="FileUpload" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Назад</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4">
                                <i class="bi bi-plus-circle"></i> Създай
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}