@using AppData.Enums
<link rel="stylesheet" href="~/css/filter.css" />
<div class="filter-card shadow-sm border-0 mb-4" style="background-color: #fff; border-radius: 15px; padding: 25px; border: 1px solid var(--lms-beige) !important;">
    <form asp-controller="StudyMaterials" asp-action="Index" method="get">
        <h5 class="mb-4 fw-bold" style="color: var(--lms-brown); border-bottom: 2px solid var(--lms-orange); display: inline-block; padding-bottom: 5px;">
            <i class="bi bi-funnel"></i> Филтри за търсене
        </h5>

        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Търси:</label>
                <input type="search" class="form-control border-beige shadow-none" name="search" value="@ViewBag.Search" placeholder="Ключова дума..." />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Учител:</label>
                <input type="search" class="form-control border-beige shadow-none" name="created-name" value="@ViewBag.CreatedName" placeholder="Име на учител..." />
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Категория:</label>
                <select class="form-select border-beige shadow-none" name="category">
                    <option value="">Избери Категория</option>
                    @foreach (var category in Enum.GetValues(typeof(Category)))
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Предмет:</label>
                <input type="search" class="form-control border-beige shadow-none" name="subject" value="@ViewBag.Subject" placeholder="Математика, БЕЛ..." />
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Тип файл:</label>
                <select class="form-select border-beige shadow-none" name="typefile">
                    <option value="">Избери Тип Файл</option>
                    @foreach (var typefile in Enum.GetValues(typeof(TypeFile)))
                    {
                        <option value="@typefile">@typefile</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase" style="color: var(--lms-brown); letter-spacing: 0.5px;">Клас:</label>
                <input type="search" class="form-control border-beige shadow-none" name="classFilter" value="@ViewBag.ClassFilter" placeholder="Напр. 10..." />
            </div>

            <div class="col-md-3 offset-md-3 d-flex align-items-end">
                <button style="background:orange;" type="submit" class="btn d-block mb-3 mt-3">
                    <i class="bi bi-search me-2"></i> Приложи филтрите
                </button>
            </div>

        </div>
    </form>
</div>

