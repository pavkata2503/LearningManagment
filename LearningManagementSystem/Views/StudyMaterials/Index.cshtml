@using AppData.Models.ViewModels
@model PaginatedResult<StudyMaterialViewModel>

@{
    ViewData["Title"] = "Учебни материали";
}
<style>
    :root {
        --primary-orange: #e67e22;
    }
    .material-card {
        transition: all 0.3s ease;
        border-radius: 12px;
        background: #fff;
        overflow: hidden;
        position: relative;
        border: 1px solid #eee;
    }

        .material-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border-color: var(--primary-orange);
        }

    .file-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin-right: 15px;
        flex-shrink: 0;
    }

    .type-pdf {
        background-color: #ffebee;
        color: #d32f2f;
    }

    .type-image {
        background-color: #ede7f6;
        color: #673ab7;
    }

    .type-doc {
        background-color: #e3f2fd;
        color: #1976d2;
    }

    .type-default {
        background-color: #fff3e0;
        color: #e67e22;
    }

    .btn-download {
        background-color: #f8f9fa;
        color: #5d4037;
        border: 1px solid #e0e0e0;
        font-weight: 600;
        transition: all 0.2s;
    }

        .btn-download:hover {
            background-color: var(--primary-orange);
            color: white;
            border-color: var(--primary-orange);
        }

    .delete-btn-corner {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #adb5bd;
        transition: color 0.2s;
        background: transparent;
        border: none;
    }

        .delete-btn-corner:hover {
            color: #dc3545;
        }
</style>
<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-center bg-white p-3 rounded shadow-sm mx-1 border-start border-5" style="border-color: #e67e22 !important;">
        <div class="col-md-6">
            <h1 class="m-0 fw-bold" style="color: #5d4037;">📚 Учебни материали</h1>
            <p class="text-muted mb-0">Разгледай и изтегли наличните ресурси</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <partial name="StudyMaterial_PartialViews/_AddButton" />
        </div>
    </div>

    <div class="container mt-4 mb-5">

        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold mb-0" style="color: #5d4037;">
                    <i class="bi bi-collection-play-fill me-2 text-orange" style="color: #e67e22;"></i>Учебни материали
                </h2>
                <p class="text-muted small mb-0 mt-1">Достъп до всички ресурси, качени от учителите.</p>
            </div>
            <div>
                <partial name="StudyMaterial_PartialViews/_AddButton" />
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4 rounded-3" style="background-color: #fff8f3;">
            <div class="card-body p-4">
                <h6 class="fw-bold text-secondary text-uppercase small mb-3"><i class="bi bi-funnel me-1"></i>Филтрирай ресурсите</h6>
                <partial name="StudyMaterial_PartialViews/_Filters" model="new StudyMaterialFilterModel()" />
            </div>
        </div>

        <div id="studyMaterialsList" class="min-vh-50">
            <partial name="StudyMaterial_PartialViews/_StudyMaterialsList" model="Model.Items" />
        </div>

        <div class="mt-5 d-flex justify-content-center">
            <partial name="StudyMaterial_PartialViews/_Pagination" model="Model" />
        </div>
    </div>
