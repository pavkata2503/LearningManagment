@model IEnumerable<AppData.Models.UserTestResult>

@{
    ViewData["Title"] = "Резултати на ученици";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-orange mb-0"><i class="bi bi-journal-text me-2"></i>Дневник с резултати</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">Обратно към тестовете</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ученик</th>
                            <th>Тест</th>
                            <th>Дата</th>
                            <th>Точки</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle p-2 me-2 text-secondary">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold">@item.User?.UserName</div>
                                            <small class="text-muted">@item.User?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.StudyMaterial.Title</td>
                                <td>@item.CompletedOn.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-primary rounded-pill px-3">@item.Score т.</span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Result" asp-route-id="@item.Id" class="btn btn-sm btn-outline-orange">
                                        <i class="bi bi-eye-fill me-1"></i> Виж отговорите
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-outline-orange {
        color: #e67e22;
        border-color: #e67e22;
    }

        .btn-outline-orange:hover {
            background-color: #e67e22;
            color: white;
        }
</style>