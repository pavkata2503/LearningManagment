@using AppData.Enums
@using AppData.Models.ViewModels
@model SolveTestViewModel

<h2>Решаване на тест</h2>

<form asp-action="Submit" method="post">
    <input type="hidden" asp-for="MaterialId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@Model.Questions[i].Content</h5>
                <input type="hidden" asp-for="Questions[i].QuestionId" />
                <input type="hidden" asp-for="Questions[i].Type" />

                @if (Model.Questions[i].Type == QuestionType.MultipleChoice)
                {
                    @foreach (var opt in Model.Questions[i].Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="Questions[@i].SelectedOptionId" value="@opt.Id">
                            <label class="form-check-label">@opt.Text</label>
                        </div>
                    }
                }
                else
                {
                    <textarea asp-for="Questions[i].OpenAnswer" class="form-control" rows="3"></textarea>
                }
            </div>
        </div>
    }
    <button type="submit" class="btn btn-primary">Предай теста</button>
</form>