@model IEnumerable<AppData.Models.ViewModels.TestListViewModel>

@{
    ViewData["Title"] = "Тестове";
}
<link rel="stylesheet" href="~/css/test_index.css" />

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="fw-bold mb-0" style="color: #5d4037;">
                <i class="bi bi-ui-checks me-2 text-orange" style="color: #e67e22;"></i>Налични тестове
            </h2>
            <p class="text-muted small mb-0 mt-1">Проверете знанията си чрез нашите интерактивни тестове.</p>
        </div>

        @if (User.IsInRole("Teacher"))
        {
            <div class="d-flex gap-2">
                <a asp-action="AllStudentResults" class="btn btn-outline-orange rounded-pill px-4 shadow-sm">
                    <i class="bi bi-journal-check me-2"></i>Резултати на ученици
                </a>

                <a asp-action="Create" class="btn btn-orange rounded-pill px-4 text-white shadow-sm" style="background-color: #e67e22;">
                    <i class="bi bi-plus-lg me-2"></i>Създай нов тест
                </a>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm border-0">
            <div class="mb-3">
                <i class="bi bi-clipboard-x display-1 text-orange opacity-50" style="color: #e67e22;"></i>
            </div>
            <h4 class="text-dark fw-bold">Няма намерени тестове</h4>
            <p class="text-muted">Все още няма добавени тестове в системата.</p>
            @if (User.IsInRole("Teacher"))
            {
                <a asp-action="Create" class="btn btn-outline-secondary mt-2">Създай първия тест</a>
            }
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var test in Model)
            {
                <div class="col">
                    <div class="card test-card h-100 shadow-sm border-0">

                        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-start pt-3 px-3">
                            <span class="badge bg-light border border-warning" style="color: #d35400">
                                @test.Category
                            </span>

                            @if (User.IsInRole("Teacher"))
                            {
                                <form asp-action="Delete" asp-route-materialId="@test.MaterialId" method="post" onsubmit="return confirm('ВНИМАНИЕ: Изтриването на теста ще изтрие и всички въпроси към него! Сигурни ли сте?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm text-muted hover-danger p-0" title="Изтрий тест">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="card-body text-center pt-0 pb-4 px-4">
                            <div class="test-icon-wrapper mx-auto shadow-sm">
                                <i class="bi bi-pencil-square"></i>
                            </div>

                            <h5 class="card-title fw-bold text-dark mb-2 text-truncate" title="@test.Title">
                                @test.Title
                            </h5>

                            <div class="mb-4">
                                <span class="question-count-badge">
                                    <i class="bi bi-list-ol me-1"></i> @test.QuestionsCount въпроса
                                </span>
                            </div>

                            <div class="d-grid">
                                <a asp-action="Solve" asp-route-id="@test.MaterialId" class="btn btn-start-test rounded-pill py-2 shadow-sm">
                                    <i class="bi bi-play-fill me-1"></i> Започни теста
                                </a>
                            </div>
                        </div>

                        <div class="card-footer bg-light border-0 py-2 text-center">
                            <small class="text-muted" style="font-size: 0.7rem;">Успех!</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
