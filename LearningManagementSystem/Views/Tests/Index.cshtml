@model IEnumerable<AppData.Models.ViewModels.TestListViewModel>

<div class="container">
    <h2 class="my-4">Налични тестове</h2>
    <div class="row">
        @foreach (var test in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge bg-info mb-2">@test.Category</span>
                        <h5 class="card-title">@test.Title</h5>
                        <p class="text-muted small">Брой въпроси: @test.QuestionsCount</p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <a asp-action="Solve" asp-route-id="@test.MaterialId" class="btn btn-primary w-100">Реши теста</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>