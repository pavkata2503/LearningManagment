@page
@model LoginModel

@{
    ViewData["Title"] = "Вход в системата";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

	<link rel="stylesheet" href="~/css/login.css" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card">
                    <div class="login-header">
                        <i class="bi bi-mortarboard-fill display-4 mb-2"></i>
                        <h3 class="fw-bold mb-0">LMS Portal</h3>
                        <p class="mb-0 opacity-75">Влезте във вашия акаунт</p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small text-center mb-3" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope me-2"></i>Имейл</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                                <label asp-for="Input.Password" class="text-muted"><i class="bi bi-lock me-2"></i>Парола</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" asp-for="Input.RememberMe" style="cursor: pointer;" />
                                <label class="form-check-label text-muted" asp-for="Input.RememberMe">Запомни ме</label>
                            </div>

                            <div class="d-grid mb-4">
                                <button id="login-submit" type="submit" class="btn btn-orange btn-lg rounded-pill">Вход</button>
                            </div>

                            <div class="text-center">
                                <span class="text-muted">Нямате акаунт?</span>
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-orange ms-1">Регистрирайте се</a>
                            </div>
                        </form>
                    </div>
                </div>
                @* <div class="text-center mt-3 text-white-50 small">
                    &copy; 2025 LMS Portal. Learning Management System.
                </div> *@
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>