@page
@model LoginModel

@{
    ViewData["Title"] = "Вход в системата";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <style>
        /* НАСТРОЙКИ ЗА ЗАДНИЯ ФОН */
        body {
            /* Снимка на библиотека/книги */
            background: url('https://images.unsplash.com/photo-1481627834876-b7833e8f5570?ixlib=rb-4.0.3&auto=format&fit=crop&w=2228&q=80') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
            position: relative;
        }

            /* ТЪМЕН ФИЛТЪР (OVERLAY) */
            body::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5); /* 50% затъмнение */
                z-index: -1; /* Да стои зад съдържанието */
            }

        .container {
            position: relative;
            z-index: 1;
        }

        .login-card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2); /* По-силна сянка */
            overflow: hidden;
            background-color: rgba(255, 255, 255, 0.95); /* Леко прозрачно бяло */
        }

        .login-header {
            background-color: #e67e22;
            color: white;
            padding: 30px 20px;
            text-align: center;
        }

        .btn-orange {
            background-color: #e67e22;
            color: white;
            border: none;
            font-weight: 600;
            padding: 12px;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: #d35400;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(230, 126, 34, 0.4);
            }

        .form-control:focus {
            border-color: #e67e22;
            box-shadow: 0 0 0 0.25rem rgba(230, 126, 34, 0.25);
        }

        .link-orange {
            color: #e67e22;
            text-decoration: none;
            font-weight: 500;
        }

            .link-orange:hover {
                color: #d35400;
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card">
                    <div class="login-header">
                        <i class="bi bi-mortarboard-fill display-4 mb-2"></i>
                        <h3 class="fw-bold mb-0">LMS Portal</h3>
                        <p class="mb-0 opacity-75">Влезте във вашия акаунт</p>
                    </div>

                    <div class="card-body p-4 p-md-5">
                        <form id="account" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger small text-center mb-3" role="alert"></div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                                <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope me-2"></i>Имейл</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                                <label asp-for="Input.Password" class="text-muted"><i class="bi bi-lock me-2"></i>Парола</label>
                                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" asp-for="Input.RememberMe" style="cursor: pointer;" />
                                <label class="form-check-label text-muted" asp-for="Input.RememberMe">Запомни ме</label>
                            </div>

                            <div class="d-grid mb-4">
                                <button id="login-submit" type="submit" class="btn btn-orange btn-lg rounded-pill">Вход</button>
                            </div>

                            <div class="text-center">
                                <span class="text-muted">Нямате акаунт?</span>
                                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="link-orange ms-1">Регистрирайте се</a>
                            </div>
                        </form>
                    </div>
                </div>
                @* <div class="text-center mt-3 text-white-50 small">
                    &copy; 2025 LMS Portal. Learning Management System.
                </div> *@
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>