@page
@model RegisterModel

@{
    ViewData["Title"] = "Регистрация";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

	<link rel="stylesheet" href="~/css/register.css" />
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                <div class="card register-card">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h2 class="fw-bold text-dark">Създай профил</h2>
                            <p class="text-muted">Стани част от нашата общност</p>
                        </div>

                        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm border-0" role="alert"></div>

                            <div class="section-title"><i class="bi bi-person-vcard me-2"></i>Лични данни</div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Name" class="form-control" autocomplete="nickname" aria-required="true" placeholder="Username" />
                                <label asp-for="Input.Name">Потребителско име</label>
                                <span asp-validation-for="Input.Name" class="text-danger small"></span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                                        <label asp-for="Input.FirstName">Име</label>
                                    </div>
                                    <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                                        <label asp-for="Input.LastName">Фамилия</label>
                                    </div>
                                    <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="section-title mt-4"><i class="bi bi-person-lines-fill me-2"></i>Контакти</div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                                <label asp-for="Input.Email">Имейл адрес</label>
                                <span asp-validation-for="Input.Email" class="text-danger small"></span>
                            </div>

                            <div class="row g-2 mb-3">
                                @* <div class="col-md-4">
                                    <div class="form-floating">
                                        <input asp-for="Input.Class" class="form-control" placeholder="Class" />
                                        <label asp-for="Input.Class"><i class="bi bi-mortarboard me-1"></i>Клас</label>
                                    </div>
                                    <span asp-validation-for="Input.Class" class="text-danger small"></span>
                                </div> *@
                                <div class="col-md-8">
                                    <div class="form-floating">
                                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone" />
                                        <label asp-for="Input.PhoneNumber"><i class="bi bi-telephone me-1"></i>Телефон</label>
                                    </div>
                                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="section-title mt-4"><i class="bi bi-shield-lock me-2"></i>Парола</div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" />
                                        <label asp-for="Input.Password">Парола</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm" />
                                        <label asp-for="Input.ConfirmPassword">Потвърди</label>
                                    </div>
                                </div>
                            </div>
                            <span asp-validation-for="Input.Password" class="text-danger small d-block mb-2"></span>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small d-block"></span>

                            @if (User.IsInRole("Admin"))
                            {
                                <div class="form-floating mt-3 mb-3 border-start border-4 border-warning ps-2 bg-light rounded-end">
                                    <select asp-for="Input.Role" class="form-select bg-transparent border-0" aria-required="true">
                                        <option value="">-- Избери роля --</option>
                                        <option value="Teacher">Учител</option>
                                        <option value="Student">Ученик</option>
                                    </select>
                                    <label asp-for="Input.Role" class="fw-bold text-dark">Задай Роля (Админ)</label>
                                    <span asp-validation-for="Input.Role" class="text-danger small"></span>
                                </div>
                            }

                            <div class="d-grid mt-4">
                                <button id="registerSubmit" type="submit" class="btn btn-register rounded-pill shadow-sm">
                                    <i class="bi bi-check-circle me-2"></i>Регистрирай се
                                </button>
                            </div>

                            <div class="text-center mt-3">
                                <a asp-page="./Login" class="text-decoration-none text-muted small hover-orange">
                                    Вече имаш акаунт? Влез тук.
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
                @* <div class="text-center mt-3 text-white-50 small">
                    &copy; 2025 LMS Portal.
                </div> *@
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>